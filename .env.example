# sh scripts/setup.sh generates private random values when .env does not exist.
# For manual setup, replace both placeholders before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
MEDIA_DB_PASSWORD=replace-with-a-different-long-random-app-password

# Zero selects test concurrency and worker count from CPU/memory limits.
MEDIA_PROXY_REPOSITORY=mahmudvibecoding/proxy-catalog
MEDIA_PROXY_TEST_CONCURRENCY=0
MEDIA_PROXY_TEST_WORKERS=0
MEDIA_PROXY_SOURCE_CONCURRENCY=128
MEDIA_PROXY_SOURCE_PER_HOST=16
MEDIA_PROXY_SOURCE_GITHUB_CONCURRENCY=32

# Larger servers can increase these for large catalog imports.
MEDIA_DB_SHARED_BUFFERS=128MB
MEDIA_DB_MAX_WAL_SIZE=4GB
